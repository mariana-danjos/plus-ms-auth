{
  "name": "plus-ms-auth",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "coverage": "jest --coverage --runInBand",
    "build": "tsc",
    "migrate:up": "node -r dotenv/config -r ts-node/register node_modules/.bin/node-pg-migrate up --migrations-dir ./migrations --migration-file-language ts",
    "migrate:down": "node -r dotenv/config -r ts-node/register node_modules/.bin/node-pg-migrate down --migrations-dir ./migrations --migration-file-language ts",
    "migrate:status": "node -r dotenv/config -r ts-node/register node_modules/.bin/node-pg-migrate status --migrations-dir ./migrations --migration-file-language ts",
    "migrate:create": "node-pg-migrate create --migrations-dir ./migrations --migration-file-language ts",
    "cleanup:tokens": "ts-node src/scripts/cleanup-tokens.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "pino": "^9.3.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.2",
    "node-pg-migrate": "^7.0.0",
    "nodemon": "^3.0.2",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
