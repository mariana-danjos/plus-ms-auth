PORT=3001

# Conexão com PostgreSQL (usada pelo node-pg-migrate e pela aplicação)
DATABASE_URL=postgresql://plus:plus_secret@localhost:5432/plus_auth

# Variáveis individuais (usadas pelo plus-infra/docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=plus
DB_PASSWORD=plus_secret
DB_NAME=plus_auth

# JWT
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS / LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
